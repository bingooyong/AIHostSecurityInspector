#!/bin/sh
if [ "$1" = "--version" ]; then echo "ClamAV 1.4.0"; exit 0; fi
target=""
for arg in "$@"; do
  case "$arg" in
    --remove|--move|--copy) echo "mutation forbidden" >&2; exit 2 ;;
    -*) ;;
    *) target=$arg ;;
  esac
done
if grep -q EICAR-STANDARD-ANTIVIRUS-TEST-FILE "$target" 2>/dev/null; then
  echo "EICAR FOUND"
  exit 1
fi
echo "no threat found: $target"
exit 0
