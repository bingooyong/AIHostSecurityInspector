{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "architecture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "offline_planning_available": {
      "const": true
    },
    "linux_platform_supported": {
      "type": "boolean"
    },
    "collector_available": {
      "const": false
    },
    "scan_ready": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "version",
    "os",
    "architecture",
    "offline_planning_available",
    "linux_platform_supported",
    "collector_available",
    "scan_ready",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostsec.invalid/schemas/doctor-v1.schema.json",
  "title": "HostSec first-slice doctor v1"
}
