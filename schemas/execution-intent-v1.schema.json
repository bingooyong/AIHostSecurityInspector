{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostsec.invalid/schemas/execution-intent-v1.schema.json",
  "title": "HostSec signable execution intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_version",
    "requester_principal",
    "host_ids",
    "identity_refs",
    "asset_snapshot_hash",
    "policy_id",
    "policy_version",
    "policy_hash",
    "profile",
    "modules",
    "tools",
    "allowed_paths",
    "excluded_paths",
    "excluded_mount_types",
    "limits",
    "required_capabilities",
    "valid_from",
    "valid_until",
    "maintenance_window",
    "mode"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "canonical_version": { "const": "execution-intent-canonical-v1" },
    "requester_principal": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "host_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "maxLength": 64,
        "not": {
          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        }
      }
    },
    "identity_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
        "maxLength": 128
      }
    },
    "asset_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
      "maxLength": 128
    },
    "policy_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile": {
      "enum": ["quick", "standard", "deep", "incident-response"]
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
      }
    },
    "allowed_paths": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 256,
        "pattern": "^/"
      },
      "not": { "contains": { "const": "/" } }
    },
    "excluded_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 256,
        "pattern": "^/"
      }
    },
    "excluded_mount_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_concurrency",
        "max_files",
        "max_file_size_bytes",
        "io_max_bytes_per_second",
        "stop_on_resource_pressure",
        "maintenance_window_required"
      ],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 2 },
        "max_files": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_file_size_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "io_max_bytes_per_second": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "stop_on_resource_pressure": { "const": true },
        "maintenance_window_required": { "type": "boolean" }
      }
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
      }
    },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "maintenance_window": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["timezone", "start", "end"],
          "properties": {
            "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "mode": { "const": "READ_ONLY" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "profile": { "enum": ["deep", "incident-response"] } }
      },
      "then": {
        "properties": {
          "limits": {
            "properties": { "maintenance_window_required": { "const": true } }
          },
          "maintenance_window": {
            "type": "object"
          }
        }
      }
    }
  ]
}
