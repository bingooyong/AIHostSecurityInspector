{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "not": {
              "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
            }
          },
          "hostname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$"
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 45,
              "anyOf": [
                {
                  "format": "ipv4"
                },
                {
                  "format": "ipv6"
                }
              ],
              "allOf": [
                {
                  "not": {
                    "enum": [
                      "0.0.0.0",
                      "::"
                    ]
                  }
                },
                {
                  "not": {
                    "pattern": "%"
                  }
                },
                {
                  "not": {
                    "pattern": "^(?:22[4-9]|23[0-9])\\."
                  }
                },
                {
                  "not": {
                    "pattern": "^[fF][fF]"
                  }
                }
              ]
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "platform": {
            "const": "linux"
          },
          "architecture": {
            "enum": [
              "x86_64",
              "arm64"
            ]
          },
          "zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
          },
          "environment": {
            "enum": [
              "TEST",
              "UAT",
              "PROD"
            ]
          },
          "business_system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "authorized": {
            "type": "boolean"
          },
          "allowed_profiles": {
            "type": "array",
            "items": {
              "enum": [
                "quick",
                "standard",
                "deep",
                "incident-response"
              ]
            },
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "connection": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "transport": {
                    "const": "ssh"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "user": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
                    "not": {
                      "const": "root"
                    }
                  },
                  "auth_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "known_hosts_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "host_key_policy": {
                    "const": "strict"
                  }
                },
                "required": [
                  "transport",
                  "port",
                  "user",
                  "auth_ref",
                  "known_hosts_ref",
                  "host_key_policy"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "transport": {
                    "const": "local"
                  },
                  "host_key_policy": {
                    "const": "strict"
                  },
                  "port": {
                    "const": 0
                  },
                  "user": {
                    "const": ""
                  },
                  "auth_ref": {
                    "const": ""
                  },
                  "known_hosts_ref": {
                    "const": ""
                  }
                },
                "required": [
                  "transport",
                  "host_key_policy"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "host_id",
          "hostname",
          "addresses",
          "platform",
          "architecture",
          "zone",
          "environment",
          "business_system",
          "owner",
          "criticality",
          "authorized",
          "allowed_profiles",
          "labels",
          "connection"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": false
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "maxProperties": 1000,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "hosts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "not": {
                "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "hosts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "hosts",
    "groups"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostsec.invalid/schemas/assets-v1.schema.json",
  "title": "HostSec asset input v1"
}
